{
  "schemaVersion": 1,
  "id": "michaelspori.tresorit",
  "name": "Tresorit",
  "version": "0.6.0",
  "author": "Michael Spori",
  "license": "MIT",
  "description": "Tresorit status, transfer activity, and selective tresor sync controls in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Tresorit",
    "description": "Monitor Tresorit and choose which tresors are synced.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "fileHistoryLimit": 50
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "fileHistoryLimit",
        "type": "integer",
        "label": "Synced file history",
        "min": 10,
        "max": 200,
        "step": 10,
        "defaultValue": 50
      }
    ]
  }
}
